APP_NAME=Skenna Sodium API
ENV=dev
API_V1_PREFIX=/api/v1
API_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change_this_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Laragon MySQL default (sesuaikan user/password jika berbeda)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/skenna
MYSQL_AUTO_CREATE_DB=true
MYSQL_ADMIN_DATABASE=mysql

# Gemini + ChromaDB AI configuration
GEMINI_API_KEY=your_key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VISION_MODEL=gemini-2.5-flash
CHROMA_DB_PATH=D:/TA 2026/skenna/skenna/skenna_python/rag/chroma
RAG_TOP_K=12
RAG_DISTANCE_THRESHOLD=0.7
