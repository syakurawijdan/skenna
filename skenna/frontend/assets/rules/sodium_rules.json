  "input": {
    "tanggal_lahir": {
      "tipe": "DateTime",
      "wajib": true,
      "keterangan": "Untuk menghitung usia"
    },
    "gender": {
      "tipe": "String",
      "nilai": ["laki_laki", "perempuan"],
      "wajib": true
    },
    "riwayat_ht": {
      "tipe": "String",
      "nilai": [
        "tidak_ada",
        "ya_riwayat_saja",
        "ya_aktif_terkontrol",
        "ya_tidak_terkontrol"
      ],
      "wajib": true
    },
    "sistolik": {
      "tipe": "int|null",
      "wajib": false
    },
    "diastolik": {
      "tipe": "int|null",
      "wajib": false
    },
    "status_kehamilan": {
      "tipe": "String",
      "nilai": ["tidak_hamil", "hamil", "menyusui"],
      "wajib": false
    }
  },
  "output": {
    "batasNatrium": {
      "tipe": "int",
      "satuan": "mg/hari"
    },
    "kategori": {
      "tipe": "String",
      "nilai": ["hijau", "kuning", "merah"]
    },
    "isAnakAnak": {
